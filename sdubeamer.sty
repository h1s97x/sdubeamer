\NeedsTeXFormat{LaTeX2e}[1995/12/01]
\ProvidesPackage{sdubeamer}[2024/12/01 Shandong University Beamer Theme]

%% ===================================================================
%% Package Options
%% ===================================================================

\RequirePackage{expl3}
% \ProcessKeyOptions 由 l3keys2e 提供，显式加载以消除对 beamer 的隐式依赖
\RequirePackage{l3keys2e}
\RequirePackage{graphicx}
\ExplSyntaxOn

\DeclareKeys {
  color .tl_set:N   = \l_@@_color_tl,
  color .initial:n  = { blue },
  % 是否启用中文支持（默认开启，推荐使用 xelatex 编译）
  chinese .bool_set:N = \l_@@_chinese_bool,
  chinese .default:n  = { true },
  chinese .initial:n  = { true },
  % ctex 字体集（默认 fandol，跨平台免安装；可用 windows/mac 等覆盖）
  fontset .tl_set:N  = \l_@@_fontset_tl,
  fontset .initial:n = { fandol },
  % 页脚学校名（默认山东大学，可通过 school 选项自定义）
  school .tl_set:N  = \l_@@_school_tl,
  school .initial:n = { 山东大学 },
  % 封面英文校名（默认 Shandong University）
  enname .tl_set:N  = \l_@@_enname_tl,
  enname .initial:n = { Shandong~University },
  % 校徽文件路径（默认 assets/sdu-logo.jpg）
  logo .tl_set:N  = \l_@@_logo_tl,
  logo .initial:n = { assets/sdu-logo.jpg },
  % 答辩类型（默认硕士），可选：undergrad / master / doctor
  degree .tl_set:N  = \l_@@_degree_tl,
  degree .initial:n = { master },
}

\ProcessKeyOptions

% 将页脚学校名复制到普通命令 \sdufootertext，供非 expl3 上下文使用
% （\tl_set_eq:NN 使 \sdufootertext 与 expl3 变量同义，类型可被非 expl3 模式引用）
\tl_set_eq:NN \sdufootertext \l_@@_school_tl

% 将封面英文校名、校徽路径、答辩类型复制到普通命令，供非 expl3 上下文使用
\tl_set_eq:NN \sduenname \l_@@_enname_tl
\tl_set_eq:NN \sdulogopath \l_@@_logo_tl
\tl_set_eq:NN \sdudegreetype \l_@@_degree_tl

%% ===================================================================
%% Chinese Support (ctex / xeCJK)
%% ===================================================================

\bool_if:NT \l_@@_chinese_bool
  {
    % 构造 ctex 选项并传递，默认使用 fandol 字体集（跨平台免安装）
    \tl_set:Nx \l_tmpa_tl { fontset = \l_@@_fontset_tl }
    \exp_args:NV \PassOptionsToPackage \l_tmpa_tl { ctex }
    \RequirePackage[UTF8]{ctex}
  }

%% ===================================================================
%% Color Definition
%% ===================================================================

% 根据 color 选项切换对应的主题色三元组（默认 blue）
\str_case:Vn \l_@@_color_tl
  {
    {red} {
      \definecolor{sdu@primary}{RGB}{155, 20, 20}
      \definecolor{sdu@secondary}{RGB}{200, 60, 60}
      \definecolor{sdu@accent}{RGB}{255, 140, 0}
    }
    {cyan} {
      \definecolor{sdu@primary}{RGB}{0, 130, 130}
      \definecolor{sdu@secondary}{RGB}{0, 170, 170}
      \definecolor{sdu@accent}{RGB}{255, 165, 0}
    }
    {green} {
      \definecolor{sdu@primary}{RGB}{20, 120, 40}
      \definecolor{sdu@secondary}{RGB}{40, 160, 60}
      \definecolor{sdu@accent}{RGB}{255, 165, 0}
    }
    {purple} {
      \definecolor{sdu@primary}{RGB}{110, 30, 130}
      \definecolor{sdu@secondary}{RGB}{150, 60, 170}
      \definecolor{sdu@accent}{RGB}{255, 140, 0}
    }
    {blue} {
      \definecolor{sdu@primary}{RGB}{0, 82, 147}
      \definecolor{sdu@secondary}{RGB}{0, 123, 182}
      \definecolor{sdu@accent}{RGB}{230, 126, 34}
    }
  }
  { % 未知选项回退到默认 blue
    \definecolor{sdu@primary}{RGB}{0, 82, 147}
    \definecolor{sdu@secondary}{RGB}{0, 123, 182}
    \definecolor{sdu@accent}{RGB}{230, 126, 34}
  }

%% ===================================================================
%% Theme Settings
%% ===================================================================

\mode<presentation>

% Set Beamer theme
\usetheme{default}
\usecolortheme{seahorse}
\usefonttheme{professionalfonts}

% Custom colors
\setbeamercolor{title page}{fg=white,bg=sdu@primary}
\setbeamercolor{frametitle}{fg=sdu@primary,bg=white}
\setbeamercolor{structure}{fg=sdu@primary}
\setbeamercolor{footline}{fg=sdu@secondary,bg=white}
\setbeamercolor{headline}{fg=sdu@primary,bg=white}
\setbeamercolor{page number}{fg=sdu@primary,bg=white}
\setbeamercolor{footer school}{fg=sdu@secondary,bg=white}

% Fonts
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{footline}{size=\footnotesize}
\setbeamerfont{headline}{size=\scriptsize}
\setbeamerfont{page number}{size=\footnotesize}

\mode<all>

%% ===================================================================
%% Title Page Template
%% ===================================================================

% 根据 degree 选项确定封面上的学位类型文案（用于“学位论文答辩”页）
\def\sdu@degreetext{%
  \str_case:Vn \l_@@_degree_tl
    {
      {undergrad} { 本科毕业论文答辩 }
      {master}     { 硕士学位论文答辩 }
      {doctor}     { 博士学位论文答辩 }
    }
    { 硕士学位论文答辩 }
}

% 供用户临时覆盖学位类型文案的命令
\newcommand\sdudegree[1]{\renewcommand\sdu@degreetext{#1}}

% 供用户临时覆盖英文校名的命令
\newcommand\sduennamecmd[1]{\renewcommand\sduenname{#1}}

% 封面页：校徽 + 学校中英文全称 + 学位论文答辩专用布局
\defbeamertemplate{title page}{sdu}{
  \begin{centering}
    % ---------- 顶部校徽 ----------
    \IfFileExists{\sdulogopath}
      {\includegraphics[height=2.5cm]{\sdulogopath}}
      {\color{sdu@primary}\rule{2.5cm}{2.5cm}}% 文件缺失时用主题色方块占位
    \par\vspace*{0.5cm}

    % ---------- 学校中英文全称 ----------
    {\Large\bfseries\color{sdu@primary} \l_@@_school_tl\par}
    \vspace*{0.15cm}
    {\small\color{sdu@secondary} \sduenname\par}
    \vspace*{0.6cm}

    % ---------- 学位论文答辩标题 ----------
    {\normalsize\color{sdu@accent} \textbf{\sdu@degreetext}\par}

    % ---------- 分隔线 ----------
    \vspace*{0.4cm}
    {\color{sdu@primary}\rule{0.6\textwidth}{0.6pt}\par}
    \vspace*{0.4cm}

    % ---------- 论文/答辩标题 ----------
    {\usebeamerfont{title}\color{sdu@primary}\inserttitle\par}
    \vspace*{0.4cm}
    {\usebeamerfont{subtitle}\insertsubtitle\par}
    \vspace*{0.8cm}

    % ---------- 作者信息 ----------
    {\usebeamerfont{author}\insertauthor\par}
    \vspace*{0.3cm}
    {\usebeamerfont{institute}\insertinstitute\par}
    \vspace*{0.3cm}
    {\usebeamerfont{date}\insertdate\par}
    \vspace*{1.5cm}
  \end{centering}
}

\setbeamertemplate{title page}[sdu]

%% ===================================================================
%% Section Page Template
%% ===================================================================

\defbeamertemplate{section page}{sdu}{
  \begin{centering}
    \vspace*{2cm}
    {\LARGE\bfseries\insertsectionhead\par}
    \vspace*{1cm}
  \end{centering}
}

\setbeamertemplate{section page}[sdu]

%% ===================================================================
%% Frame Title
%% ===================================================================

\setbeamertemplate{frametitle}{
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1ex]{frametitle}
    \hspace*{0.5cm}
    \Large\bfseries\insertframetitle
  \end{beamercolorbox}
}

%% ===================================================================
%% Header (Headline) Template
%% ===================================================================

% 页眉：左侧显示当前章节名，底部为一条 SDU 主题色分隔线
% 使用 \insertsectionhead 显示章节名；无章节时留空
\defbeamertemplate{headline}{sdu}
  {
    \begin{beamercolorbox}[wd=\paperwidth,ht=2.2ex,dp=0.6ex]{headline}
      \hspace*{0.6cm}
      {\usebeamerfont{headline}\insertsectionhead}
      \hfill
      \hspace*{0.6cm}
    \end{beamercolorbox}
    % 页眉底部 SDU 主题色细线
    \nointerlineskip
    \begin{beamercolorbox}[wd=\paperwidth,ht=1pt]{structure}
    \end{beamercolorbox}
  }

\setbeamertemplate{headline}[sdu]

%% ===================================================================
%% Footer (Footline) Template
%% ===================================================================

% 页脚：顶部一条 SDU 主题色细线，左侧学校名，右侧页码
\defbeamertemplate{footline}{sdu}
  {
    % 页脚顶部 SDU 主题色细线
    \begin{beamercolorbox}[wd=\paperwidth,ht=1pt]{structure}
    \end{beamercolorbox}
    \begin{beamercolorbox}[wd=\paperwidth,ht=2.2ex,dp=1ex]{footline}
      \hspace*{0.6cm}
      {\usebeamerfont{footer school}\sdufootertext}
      \hfill
      {\usebeamerfont{page number}%
       \insertframenumber{}/\inserttotalframenumber}
      \hspace*{0.6cm}
    \end{beamercolorbox}
  }

\setbeamertemplate{footline}[sdu]

% 供页脚使用的学校名命令（默认取 school 选项，用户可用 \sdufooter 覆盖）
\newcommand\sdufooter[1]{\def\sdufootertext{#1}}

%% ===================================================================
%% List (itemize / enumerate) Styles
%% ===================================================================

% itemize：定制各级项目符号，逐级呼应 SDU 品牌色
% 一级三角、二级实心圆点、三级短横线，颜色由 sdu@primary/secondary/accent 递进
\setbeamertemplate{itemize item}{\color{sdu@primary}$\blacktriangleright$}
\setbeamertemplate{itemize subitem}{\color{sdu@secondary}$\bullet$}
\setbeamertemplate{itemize subsubitem}{\color{sdu@accent}$-$}

% enumerate：编号使用 SDU 主题色，两级缩进分别用 primary/secondary/accent
\setbeamercolor{enumerate item}{fg=sdu@primary}
\setbeamercolor{enumerate subitem}{fg=sdu@secondary}
\setbeamercolor{enumerate subsubitem}{fg=sdu@accent}
\setbeamercolor{item projected}{bg=sdu@primary,fg=white}
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\insertsubenumlabel.}
\setbeamertemplate{enumerate subsubitem}{\insertsubsubenumlabel.}

% itemize 模板采用右箭头形式的默认外观时，统一以主题色着色，保证视觉一致
\setbeamercolor{itemize item}{fg=sdu@primary}
\setbeamercolor{itemize subitem}{fg=sdu@secondary}
\setbeamercolor{itemize subsubitem}{fg=sdu@accent}

%% ===================================================================
%% Block / Theorem / Example Styles
%% ===================================================================

% 普通 block：标题用 SDU 主色实心底，正文浅色底呼应品牌色
\setbeamercolor{block title}{fg=white,bg=sdu@primary}
\setbeamercolor{block body}{fg=black,bg=sdu@primary!10}
\setbeamercolor{block title alerted}{fg=white,bg=sdu@accent}
\setbeamercolor{block body alerted}{fg=black,bg=sdu@accent!15}
\setbeamercolor{block title example}{fg=white,bg=sdu@secondary}
\setbeamercolor{block body example}{fg=black,bg=sdu@secondary!12}

% 定理类（theorem/lemma/corollary 等）：标题采用 SDU 主色
\setbeamercolor{theorem title}{fg=sdu@primary,bg=sdu@primary!8}
\setbeamercolor{theorem body}{fg=black}

% example / alert 强调文本沿用 SDU 品牌色
\setbeamercolor{example text}{fg=sdu@secondary}
\setbeamercolor{alerted text}{fg=sdu@accent}
\setbeamerfont{block title}{series=\bfseries}

%% ===================================================================
%% Caption (图/表标题) Styles
%% ===================================================================

% 图/表标题：名称（“图/表”字样）用 SDU 主色加粗，说明正文为黑色
\setbeamercolor{caption name}{fg=sdu@primary}
\setbeamercolor{caption}{fg=black}
\setbeamerfont{caption name}{size=\small,series=\bfseries}
\setbeamerfont{caption}{size=\small}

%% ===================================================================
%% Hyperlink Colors
%% ===================================================================

% 超链接配色：链接用辅助色、聚焦/悬停用强调色，呼应 SDU 品牌色
\setbeamercolor{hyperlink}{fg=sdu@secondary}
\setbeamercolor{hyperlink focused}{fg=sdu@accent}
\hypersetup{
  colorlinks=true,
  linkcolor=sdu@primary,
  urlcolor=sdu@secondary,
  citecolor=sdu@accent,
  anchorcolor=sdu@accent,
}

%% ===================================================================
%% Navigation Symbols
%% ===================================================================

\setbeamertemplate{navigation symbols}{}

%% ===================================================================
%% Closing
%% ===================================================================

\ExplSyntaxOff
\endinput
